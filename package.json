{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json && svelte-check --tsconfig ./tsconfig.svelte.json",
    "fmt": "oxfmt src",
    "lint": "oxlint src",
    "lint:error": "oxlint --quiet src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest",
    "test:once": "vitest run",
    "prepare": "husky",
    "verify:build": "tsx scripts/verify-static-build.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/react": "^7.1.0",
    "@astrojs/svelte": "^9.1.0",
    "@astrojs/vue": "^7.1.0",
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-router": "^1.170.16",
    "astro": "7.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "satteri": "0.10.5",
    "svelte": "^5.57.2",
    "unist-util-visit": "^5.1.0",
    "vue": "^3.5.44",
    "yaml": "2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-vite-plugin": "^1.167.18",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "2.16.2",
    "@typescript/native-preview": "7.0.0-dev.20260618.1",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "html-validate": "11.16.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "playwright": "^1.61.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  }
}
