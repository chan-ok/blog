{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json && svelte-check --tsconfig ./tsconfig.svelte.json",
    "fmt": "oxfmt \"src/**/*.{ts,tsx,json,css}\" && prettier --write \"src/**/*.{astro,vue,svelte}\"",
    "lint": "oxlint src",
    "lint:error": "oxlint --quiet src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest",
    "test:once": "vitest run",
    "prepare": "husky",
    "verify:build": "tsx scripts/verify-static-build.ts",
    "fmt:check": "oxfmt --check \"src/**/*.{ts,tsx,json,css}\" && prettier --check \"src/**/*.{astro,vue,svelte}\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/react": "^7.1.0",
    "@astrojs/svelte": "^9.1.0",
    "@astrojs/vue": "^7.1.0",
    "astro": "7.4.0",
    "dompurify": "^3.4.12",
    "mermaid": "^11.15.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "^2.18.1",
    "satteri": "0.10.5",
    "svelte": "^5.57.2",
    "vue": "^3.5.44",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "2.16.2",
    "html-validate": "11.16.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "playwright": "^1.61.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{astro,vue,svelte}": [
      "prettier --write"
    ]
  }
}
