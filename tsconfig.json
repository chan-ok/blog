{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "astro.config.mjs",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.fixture.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".cache"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
