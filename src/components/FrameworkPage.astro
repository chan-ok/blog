---
import BlogPage from '../frameworks/react/BlogPage';
import VueBlogPage from '../frameworks/vue/BlogPage.vue';
import SvelteBlogPage from '../frameworks/svelte/BlogPage.svelte';
import type { PageModel } from '../lib/presentation/page-model';
interface Props {
  model: PageModel;
}
const { model } = Astro.props;
---

{model.context.framework === 'react' && <BlogPage model={model} client:load />}
{model.context.framework === 'vue' && <VueBlogPage model={model} client:load />}
{model.context.framework === 'svelte' && (
  <SvelteBlogPage model={model} client:load />
)}
